# === Frontend ===
# See frontend/.env.example for details
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# === Backend ===
# See backend/.env.example for full details
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5435/app_db?sslmode=disable
SESSION_COOKIE_NAME=app_session
LOG_LEVEL=debug
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:3000
